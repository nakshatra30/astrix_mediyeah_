meta {
  name: Categories - Create
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/admin/categories
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "name": "Bruno Test Category",
    "slug": "bruno-test-category",
    "division": "TECHNOLOGY",
    "description": "Category created for API testing.",
    "displayOrder": 99,
    "isActive": true
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.data) {
    if (body.data.id) bru.setVar("categoryId", body.data.id);
  }
}

tests {
  test("Categories - Create returns HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("data");
  });
}
