meta {
  name: Auth - Me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: none
}

headers {
  Accept: application/json
}

script:post-response {
  const body = res.getBody();
  if (body && body.data) {
    if (body.data.csrfToken) bru.setVar("csrfToken", body.data.csrfToken);
  }
}

tests {
  test("Auth - Me returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("data");
  });
}

example {
  name: 200
  
  request: {
    url: {{baseUrl}}/auth/me
    method: GET
    mode: none
    headers: {
      Accept: application/json
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'none';frame-ancestors 'none';base-uri 'none';form-action 'none'
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: cross-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      vary: Origin
      access-control-allow-credentials: true
      x-request-id: 47343825-cabe-49d1-9469-d67ecf1d5507
      ratelimit-policy: 300;w=60
      ratelimit: limit=300, remaining=297, reset=12
      content-type: application/json; charset=utf-8
      content-length: 271
      etag: W/"10f-pnzSRBIHRAiePZjcVmeS+MnDtjk"
      date: Wed, 11 Nov 2026 10:01:16 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "id": "0e2bd935-996c-4a9a-909e-9dc8d8ee1551",
            "name": "Astrix Admin",
            "email": "astrix.mediyeah@gmail.com",
            "createdAt": "2026-11-11T09:12:57.545Z",
            "lastLoginAt": "2026-11-11T10:01:07.315Z",
