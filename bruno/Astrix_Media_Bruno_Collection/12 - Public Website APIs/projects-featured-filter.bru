meta {
  name: Public Website - Filter Featured Projects
  type: http
  seq: 49
}

get {
  url: {{baseUrl}}/public/projects?featured=true&page=1&pageSize=10
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Featured filter returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Featured filter returns only featured published projects", function () {
    const body = res.getBody();
    expect(body.data).to.be.an("array");
    expect(body.meta.total).to.be.at.least(1);
    for (const project of body.data) {
      expect(project.isFeatured).to.equal(true);
      expect(project.status).to.equal("PUBLISHED");
    }
  });
}
