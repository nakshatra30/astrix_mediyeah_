// Astrix Media — database schema
// Envelopes and field names mirror the Bruno API collection exactly.

generator client {
  provider                = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Division {
  TECHNOLOGY
  CREATIVE
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  CONVERTED
  CLOSED
  SPAM
}

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  email       String    @unique
  passwordHash String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  lastLoginAt DateTime? @db.Timestamptz(3)

  sessions AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String   @id
  csrfToken String
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_sessions")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  division     Division
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  projects Project[]

  @@index([division, isActive, displayOrder])
  @@map("categories")
}

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  slug             String   @unique
  division         Division
  shortDescription String?
  description      String?
  deliverables     String[] @default([])
  iconKey          String?
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  enquiries Enquiry[]

  @@index([division, isActive, displayOrder])
  @@map("services")
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  title            String
  slug             String        @unique
  division         Division
  categoryId       String?       @db.Uuid
  shortDescription String?
  fullDescription  String?
  challenge        String?
  solution         String?
  process          String?
  technologies     String[]      @default([])
  projectUrl       String?
  repositoryUrl    String?
  isFeatured       Boolean       @default(false)
  status           ProjectStatus @default(DRAFT)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  category Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   ProjectImage[]

  @@index([division, status])
  @@index([status, createdAt])
  @@index([categoryId])
  @@map("projects")
}

model ProjectImage {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  mediaAssetId String   @db.Uuid
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([projectId, mediaAssetId])
  @@map("project_images")
}

model Testimonial {
  id                 String    @id @default(uuid()) @db.Uuid
  clientName         String
  designation        String?
  companyName        String?
  quote              String
  rating             Int       @default(5)
  isPublished        Boolean   @default(true)
  displayOrder       Int       @default(0)
  avatarMediaAssetId String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  avatar MediaAsset? @relation(fields: [avatarMediaAssetId], references: [id], onDelete: Restrict)

  @@index([isPublished, displayOrder])
  @@map("testimonials")
}

model Enquiry {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  email              String
  phone              String?
  company            String?
  serviceId          String?       @db.Uuid
  serviceNameSnapshot String?
  budgetRange        String?
  preferredContactMethod String?
  projectDescription String
  privacyConsent     Boolean       @default(false)
  status             EnquiryStatus @default(NEW)
  sourcePage         String?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  service Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  notes   EnquiryNote[]

  @@index([status, createdAt])
  @@map("enquiries")
}

model EnquiryNote {
  id        String   @id @default(uuid()) @db.Uuid
  enquiryId String   @db.Uuid
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, createdAt])
  @@map("enquiry_notes")
}

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  filename  String
  url       String
  secureUrl String
  publicId  String   @unique
  mimeType  String
  byteSize  Int
  width     Int?
  height    Int?
  storage   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  projectImages ProjectImage[]
  testimonials  Testimonial[]

  @@map("media_assets")
}

model SiteSettings {
  id             String   @id @default("singleton")
  agencyName     String?
  tagline        String?
  heroTitle      String?
  heroSubtitle   String?
  aboutIntro     String?
  contactEmail   String?
  contactPhone   String?
  whatsappNumber String?
  address        String?
  socialInstagram String?
  socialLinkedIn  String?
  socialX         String?
  socialFacebook  String?
  socialYoutube   String?
  footerText     String?
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}
