# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or any Postgres). Use a DIRECT
# (non-pooled) connection here — both the app and the Prisma CLI use it.
# On Neon this is the endpoint host WITHOUT the "-pooler" suffix.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Shadow database used only by `prisma migrate dev` (development).
SHADOW_DATABASE_URL=postgresql://user:password@host/shadowdb?sslmode=require
# Dedicated database for the automated test suite (vitest). Never point this
# at your development or production database.
TEST_DATABASE_URL=postgresql://user:password@host/testdb?sslmode=require

# ── Sessions ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=astrix.sid
SESSION_TTL_HOURS=8
BCRYPT_ROUNDS=12

# ── CORS / public URLs ─────────────────────────────────────────────────────
# Frontend origin allowed to call this API with credentials (cookies).
CLIENT_URL=http://localhost:5173
# Public base URL used to build image URLs for local-disk storage.
PUBLIC_BASE_URL=http://localhost:5000

# ── Media storage (optional) ───────────────────────────────────────────────
# Leave all three unset to store uploads on local disk (backend/uploads) in
# development. Set them to upload to Cloudinary instead.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=astrix-media
